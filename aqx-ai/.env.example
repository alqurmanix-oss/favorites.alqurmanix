# Required: set a unique, high-entropy secret before exposing the API.
AQX_AI_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Local model cache. Mount persistent storage here in production.
HF_HOME=/models/huggingface
TRANSFORMERS_CACHE=/models/huggingface

# Small CPU-friendly starter models. Override only after evaluation.
AQX_TEXT_MODEL=/models/text
AQX_ASR_MODEL=/models/asr
AQX_IMAGE_SAFETY_MODEL=/models/image

# Automatic publication is hard-disabled in code until validation is approved.
AQX_MAX_UPLOAD_MB=10
AQX_MAX_AUDIO_SECONDS=900
AQX_MAX_IMAGE_PIXELS=20000000

# Exact Supabase Storage host used by AQX Favorites review-media signed URLs.
AQX_ALLOWED_MEDIA_HOSTS=vuszqzgldbsscuxdfhdz.supabase.co

